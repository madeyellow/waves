.footstep-root {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    position: relative;
}

.footstep-preview {
    flex-grow: 1;
    min-height: 96px;
    position: relative;
    background-color: rgba(0, 0, 0, 0.18);
}

.footstep-split {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 36px;
}

.footstep-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    background-color: var(--unity-colors-toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-toolbar_button-border);
}

.footstep-dock .unity-object-field {
    flex-grow: 1;
    margin-right: 6px;
    min-width: 160px;
}

.footstep-dock .unity-base-field__aligned > .unity-base-field__label {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    min-width: 0;
    width: auto;
    margin-left: 2px;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
}

.footstep-dock .footstep-bake {
    margin-left: auto;
    margin-right: 0;
}

.footstep-body {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.footstep-preview-imgui {
    flex-grow: 1;
}

.footstep-preview-empty {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 40%;
    -unity-text-align: middle-center;
}

.footstep-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    flex-shrink: 0;
    background-color: var(--unity-colors-toolbar-background);
}

.footstep-profile-host {
    flex-direction: row;
    align-items: center;
    margin-left: 2px;
    margin-right: 0;
    min-width: 0;
}

.footstep-profile-add {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 2px;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
}

.footstep-gutter-profile {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

.footstep-gutter-profile .unity-base-popup-field__text {
    overflow: hidden;
    text-overflow: ellipsis;
}

.footstep-tools {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
}

.footstep-history {
    margin-left: auto;
    margin-right: 0;
}

.footstep-speed {
    flex-direction: row;
    align-items: center;
    width: 168px;
    margin-left: 8px;
    flex-shrink: 0;
}

.footstep-speed-slider {
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 6px;
}

.footstep-speed-value {
    width: 36px;
    font-size: 11px;
    -unity-text-align: middle-right;
}

.footstep-type-group {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    flex-shrink: 0;
}

.footstep-type-label {
    margin-right: 4px;
    flex-shrink: 0;
}

.footstep-type-dropdown {
    width: 148px;
    min-width: 96px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 2px;
}

.footstep-type-create {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 2px;
    padding-left: 8px;
    padding-right: 8px;
}

.footstep-clip {
    width: 200px;
    min-width: 120px;
    flex-grow: 0;
    flex-shrink: 1;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 8px;
    margin-right: 0;
}

.footstep-tool {
    width: 28px;
    height: 24px;
    padding: 0;
    margin: 0 2px 0 0;
    align-items: center;
    justify-content: center;
}

.footstep-tool-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
}

.footstep-tool-separator {
    width: 1px;
    height: 16px;
    margin-left: 6px;
    margin-right: 8px;
    background-color: var(--unity-colors-toolbar_button-border);
}

.footstep-bake {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    padding-right: 6px;
}

.footstep-bake.footstep-bake-dirty:enabled {
    background-color: #3d9b66;
    color: #ffffff;
    border-width: 1px;
    border-left-color: #2f7a4e;
    border-right-color: #2f7a4e;
    border-top-color: #2f7a4e;
    border-bottom-color: #2f7a4e;
}

.footstep-bake.footstep-bake-dirty:enabled:hover {
    background-color: #47b074;
}

.footstep-bake .footstep-tool-icon {
    margin-right: 4px;
}

.footstep-bake.footstep-bake-dirty .footstep-tool-icon {
    -unity-background-image-tint-color: #ffffff;
}

.footstep-tool-on {
    background-color: rgba(70, 130, 210, 0.45);
    border-width: 1px;
    border-left-color: rgb(80, 145, 230);
    border-right-color: rgb(80, 145, 230);
    border-top-color: rgb(80, 145, 230);
    border-bottom-color: rgb(80, 145, 230);
}

.footstep-timeline {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    position: relative;
}

.footstep-ruler-row {
    flex-direction: row;
    min-height: 22px;
    flex-shrink: 0;
}

.footstep-gutter {
    width: 160px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    position: relative;
    padding-right: 6px;
}

.footstep-gutter-split {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 3px;
    background-color: #cbcbcb;
    border-left-width: 1px;
    border-left-color: #cbcbcb;
    cursor: split-resize-left-right;
}

.unity-theme-dark .footstep-gutter-split {
    background-color: #2c2c2c;
    border-left-color: #2c2c2c;
}

.footstep-ruler {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    cursor: link;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar_button-border);
}

.footstep-tick {
    position: absolute;
    top: 2px;
    font-size: 10px;
}

.footstep-scroll {
    flex-grow: 1;
    min-height: 0;
}

.footstep-track {
    flex-direction: row;
    height: 40px;
    margin-bottom: 2px;
}

.footstep-add-track-row {
    flex-direction: row;
    flex-shrink: 0;
    height: 24px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.footstep-add-track {
    height: 22px;
    margin-left: 4px;
    margin-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.footstep-track-name {
    width: 160px;
    flex-shrink: 0;
    position: relative;
    flex-direction: column;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
    cursor: move-arrow;
    overflow: hidden;
    border-left-width: 4px;
}

.footstep-track-title {
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.footstep-track-bake {
    margin-top: -1px;
    font-size: 9px;
    opacity: 0.72;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.footstep-lane {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

.footstep-frame-grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.footstep-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: #EB9483;
    overflow: visible;
}

.footstep-playhead-head {
    position: absolute;
    top: 0;
    left: -5px;
    width: 12px;
    height: 8px;
}

.footstep-step {
    position: absolute;
    top: 4px;
    bottom: 4px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    border-radius: 3px;
    padding-left: 8px;
    padding-right: 8px;
    cursor: move-arrow;
    border-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.footstep-step-ghost {
    opacity: 0.45;
}

.footstep-step-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
}

.footstep-step-label {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.footstep-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 6px;
    background-color: rgba(0, 0, 0, 0.28);
    cursor: resize-horizontal;
}

.footstep-handle-left {
    left: 0;
}

.footstep-handle-right {
    right: 0;
}

.footstep-model-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.footstep-model-empty-copy {
    width: 460px;
    max-width: 90%;
    margin-bottom: 18px;
    align-items: center;
}

.footstep-model-empty-title {
    width: 100%;
    margin-bottom: 12px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--unity-colors-default-text);
}

.footstep-model-empty-body,
.footstep-model-empty-lead {
    width: 100%;
    font-size: 12px;
    opacity: 0.75;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--unity-colors-default-text);
}

.footstep-model-empty-lead {
    margin-top: 10px;
    margin-bottom: 4px;
}

.footstep-model-empty-list {
    align-items: flex-start;
}

.footstep-model-empty-item {
    flex-direction: row;
    align-items: flex-start;
}

.footstep-model-empty-mark {
    width: 14px;
    margin-right: 4px;
    font-size: 12px;
    opacity: 0.75;
    -unity-text-align: middle-center;
    color: var(--unity-colors-default-text);
}

.footstep-model-empty-item-text {
    font-size: 12px;
    opacity: 0.75;
    white-space: normal;
    color: var(--unity-colors-default-text);
}

.footstep-model-empty-button {
    font-size: 13px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
}

.footstep-help {
    flex-grow: 1;
    padding: 24px;
    white-space: normal;
    -unity-text-align: upper-center;
}
